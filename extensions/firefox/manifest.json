{
  "manifest_version": 3,
  "name": "Cookie Monster",
  "version": "0.1.0",
  "description": "Local cookie visibility and control via Cookie Monster core.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-monster@cookiemonster.local",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_title": "Cookie Monster",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
