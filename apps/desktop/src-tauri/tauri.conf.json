{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cookie Monster",
  "version": "0.3.0",
  "identifier": "com.cookiemonster.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Cookie Monster",
        "width": 400,
        "height": 560,
        "visible": true,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "deb", "appimage"],
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/tray-template.png",
      "icons/wendy.h@example.net"
    ],
    "resources": [
      "binaries/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
