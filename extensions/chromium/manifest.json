{
  "manifest_version": 3,
  "name": "Cookie Monster",
  "version": "0.2.0",
  "description": "Local cookie visibility and control via Cookie Monster core.",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cookie Monster",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
