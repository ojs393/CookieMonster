{
  "manifest_version": 3,
  "name": "Cookie Monster",
  "version": "0.2.0",
  "description": "Local cookie visibility and control (Safari Web Extension).",
  "permissions": ["cookies", "nativeMessaging", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false,
    "type": "module"
  },
  "action": {
    "default_title": "Cookie Monster",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.0"
    }
  }
}
